#!/usr/bin/env bash
# neat-os required check. Same command locally, in CI, and for agents.
# Runs: structure (paths, indexes, package agreement) → policy (short ADR-backed
# prose lint) → neutral reference (client and internal detail in published text) →
# smoke (init / gather / resolve-consume against temp repos).
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."

node scripts/check-structure.js
node scripts/check-policy.js
node scripts/check-neutral.js
node scripts/check-smoke.js

echo "neat-os check OK"
